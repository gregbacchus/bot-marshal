---
import Default from '@astrojs/starlight/components/Head.astro';

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'bot-marshal',
  url: 'https://bot-marshal.sh/',
  description: 'An open-source egress firewall for AI agents.',
};
---

<Default><slot /></Default>
{Astro.url.pathname === '/' && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(website)} />
)}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
/>

<!-- Cloudflare Web Analytics: keep this external script unbundled. -->
<script
  is:inline
  type="module"
  src="https://static.cloudflareinsights.com/beacon.min.js"
  data-cf-beacon='{"token": "ba12f3f433e940079cb1271fad5cdf80"}'
></script>
